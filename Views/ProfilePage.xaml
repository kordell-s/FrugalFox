<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FrugalFoxBudgetApp.ViewModels"
             x:Class="FrugalFoxBudgetApp.Views.ProfilePage"
             Title="Profile">
    

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            <Label Text="Profile Settings" FontSize="18" HorizontalOptions="Center" FontAttributes="Bold" FontFamily="Oswald"/>

            <!-- User Name -->
            <Label Text="Full Name" FontSize="16" FontAttributes="Bold" FontFamily="Oswald"/>
            <Entry Text="{Binding Name}" Placeholder="Enter your name"/>

            <!-- Email -->
            <Label Text="Email" FontSize="16" FontAttributes="Bold" FontFamily="Oswald"/>
            <Entry Text="{Binding Email}" Placeholder="Enter your email" IsEnabled="False"/>

            <!-- Change Password -->
            <Label Text="New Password" FontSize="16" FontAttributes="Bold" FontFamily="Oswald"/>
            <Entry Text="{Binding NewPassword}" Placeholder="Enter new password" IsPassword="True"/>

            <!-- Theme Toggle -->
            <Label Text="Select Theme" FontSize="16" FontAttributes="Bold" FontFamily="Oswald"/>
            <Picker ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"/>

            <!-- Save Button -->
            <Button Text="Save Changes" Command="{Binding SaveCommand}" BackgroundColor="#EA4337" TextColor="White" FontFamily="Oswald"/>

            <!-- Logout Button -->
            <Button Text="Logout" Command="{Binding LogoutCommand}" BackgroundColor="Gray" TextColor="White" FontFamily="Oswald"/>
            
        </StackLayout>
    </ScrollView>
</ContentPage>