<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FrugalFoxBudgetApp.ViewModels"
             x:Class="FrugalFoxBudgetApp.DashboardPage">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20" Spacing="20" >
                <!-- Heading -->
                <Label Text="{Binding Greeting}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                
                <!-- Budget -->
                <Frame BackgroundColor="#EA4337" CornerRadius="10" Padding="15">
                    <StackLayout Spacing="10">
                        <Label Text="Monthly Budget" FontSize="Medium" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"></Label>
                        
                        <Label Text="{Binding MonthlyBudget, StringFormat='{}{0:C}'}" FontSize="24" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold"/>
                        
                        <Label Text="{Binding BudgetStatus}"  TextColor="White" HorizontalOptions="Center"/>
                    </StackLayout>
                    </Frame>
                
                <!-- Recent Transactions -->
                <Label Text="Recent Transactions" FontSize="Medium" FontAttributes="Bold"></Label>
                <CollectionView ItemsSource="{Binding RecentTransactions}" SelectionMode = "None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TransactionViewModel">
                            <Frame CornerRadius="8" Padding="10" Margin="5">
                                <StackLayout Spacing="5">
                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="{Binding CategoryIcon}" 
                                               WidthRequest="20" 
                                               HeightRequest="20"
                                               Margin="0,0,5,0" />
                                        <Label Text="{Binding Title}" FontAttributes="Bold"></Label>
                                       <!-- <Label Text="{Binding CategoryName}"></Label> -->
                                        <Label Text="{Binding Amount, StringFormat='{}{0:C}'}" FontAttributes="Bold" TextColor="#EA4337" HorizontalOptions="EndAndExpand" />
                                    </StackLayout>
                                    <Label Text="{Binding Date, StringFormat ='{0:MM / dd}'}" FontSize="Small" TextColor="Gray"></Label>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <!-- Quick Actions -->
                
                <!--<Button Text="Add Transaction" BackgroundColor="#EA4337" Command="{Binding AddTransactionCommand}"></Button>
                <Button Text="Set Budget" BackgroundColor="#EA4337" Command="{Binding SetBudgetCommand}"></Button>
                <Button Text="View Reports" BackgroundColor="#EA4337" Command="{Binding ViewReportsCommand}"></Button>-->
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>