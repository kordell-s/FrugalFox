<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FrugalFoxBudgetApp.ViewModels"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="FrugalFoxBudgetApp.Views.DashboardPage">
  
  <ContentPage.BindingContext>
      <vm:DashboardPageViewModel/>
  </ContentPage.BindingContext>

  <Grid>
    <!-- Main content in a ScrollView -->
    <ScrollView>
      <StackLayout Padding="20" Spacing="20">
        <!-- Heading -->
        <Label Text="{Binding Greeting}" 
               FontSize="24" 
               FontAttributes="Italic" 
               HorizontalOptions="Start"
               FontFamily="Oswald"/>

        <Label Text="{Binding MonthlyBudget, StringFormat='Budget: {0:C}'}" 
               FontSize="20" 
               FontAttributes="Bold" 
               HorizontalOptions="Start" 
               FontFamily="Oswald"/>
        <Label Text="{Binding BudgetStatus}"
               FontSize="18"
               FontAttributes="Italic"
               HorizontalOptions="Start"
               FontFamily="Oswald"
               />


        <!-- Donut Chart -->
        <syncfusion:SfCircularChart HeightRequest="250">
          <syncfusion:SfCircularChart.Legend>
            <syncfusion:ChartLegend ToggleSeriesVisibility="True"/>
          </syncfusion:SfCircularChart.Legend>
          <syncfusion:SfCircularChart.Series>
            <syncfusion:DoughnutSeries ItemsSource="{Binding ChartData}"
                                       XBindingPath="Category"
                                       YBindingPath="Value"
                                       EnableTooltip="True"
                                       ShowDataLabels="True">
              <syncfusion:DoughnutSeries.PaletteBrushes>
                <SolidColorBrush Color="#EA4337"/>
                <SolidColorBrush Color="#CCCCCC"/>
              </syncfusion:DoughnutSeries.PaletteBrushes>
              <syncfusion:DoughnutSeries.DataLabelSettings>
                <syncfusion:CircularDataLabelSettings LabelPosition="Outside" LabelPlacement="Auto">
                  <syncfusion:CircularDataLabelSettings.LabelStyle>
                    <syncfusion:ChartDataLabelStyle FontSize="14" 
                                                    FontAttributes="Bold"
                                                    LabelFormat="${Value} ({Percent}%)"
                                                    TextColor="White"/>
                  </syncfusion:CircularDataLabelSettings.LabelStyle>
                </syncfusion:CircularDataLabelSettings>
              </syncfusion:DoughnutSeries.DataLabelSettings>
            </syncfusion:DoughnutSeries>
          </syncfusion:SfCircularChart.Series>
        </syncfusion:SfCircularChart>
        
        <syncfusion:SfCircularChart.Legend>
          <syncfusion:ChartLegend ToggleSeriesVisibility="True"
                                  LabelStyle="{StaticResource LegendLabelStyle}" />
        </syncfusion:SfCircularChart.Legend>

        <!-- Recent Transactions Header -->
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
          <Label Text="Recent Transactions" 
                 FontSize="Medium" 
                 FontAttributes="Bold" 
                 VerticalOptions="Center"
                 FontFamily="Oswald"/>
          <Label Text="View Transactions" 
                 FontSize="Medium" 
                 TextColor="#EA4337"
                 VerticalOptions="Center"
                 HorizontalOptions="End"
                 FontFamily="Oswald">
            <Label.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding ViewTransactionsCommand}" />
            </Label.GestureRecognizers>
          </Label>
        </Grid>

        <!-- Recent Transactions List -->
        <CollectionView ItemsSource="{Binding RecentTransactions}" SelectionMode="None">
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:TransactionViewModel">
              <Frame CornerRadius="8" Padding="10" Margin="5">
                <StackLayout Spacing="5">
                  <StackLayout Orientation="Horizontal">
                    <Image Source="{Binding CategoryIcon}" 
                           WidthRequest="20" 
                           HeightRequest="20" 
                           Margin="0,0,5,0" BackgroundColor="White"/>
                    <Label Text="{Binding Title}" FontAttributes="Bold" FontFamily="Oswald"/>
                    <Label Text="{Binding Amount, StringFormat='{}{0:C}'}" FontFamily="Oswald"
                           FontAttributes="Bold" 
                           TextColor="#EA4337" 
                           HorizontalOptions="EndAndExpand"/>
                  </StackLayout>
                  <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}" 
                         FontSize="Small" 
                         TextColor="Gray" FontFamily="Oswald"/>
                </StackLayout>
              </Frame>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
      </StackLayout>
    </ScrollView>

    <!-- Floating Action Button -->
    <Button Text="+" 
            FontSize="24" 
            FontAttributes="Bold"
            Command="{Binding AddTransactionCommand}"
            BackgroundColor="#EA4337" 
            TextColor="White"
            CornerRadius="24"
            WidthRequest="46"
            HeightRequest="46"
            Margin="0,0,20,20"
            HorizontalOptions="End"
            VerticalOptions="End"/>
  </Grid>
  
  <ContentPage.Resources>
    <ResourceDictionary>
      <syncfusion:ChartLegendLabelStyle x:Key="LegendLabelStyle"
                                        TextColor="White"
                                        FontSize="14"
                                        FontAttributes="Bold"/>
    </ResourceDictionary>
  </ContentPage.Resources>
</ContentPage>
