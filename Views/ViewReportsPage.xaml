<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrugalFoxBudgetApp.Views.ViewReportsPage">
    <ContentPage.Content>
        <StackLayout Padding="20">
            <Label Text="Reports" FontSize="24" HorizontalOptions="Center" />
            <ListView ItemsSource="{Binding ReportItems}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding Title}" Detail="{Binding Detail}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>