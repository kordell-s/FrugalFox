<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:FrugalFoxBudgetApp.ViewModels"
             x:Class="FrugalFoxBudgetApp.Views.EditTransactionPage"
             Title="Edit Transaction">

    <ContentPage.BindingContext>
        <viewModels:EditTransactionViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <Label Text="Edit Transaction" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   FontFamily="Oswald"
                   HorizontalOptions="Center"/>

            <!-- Transaction Title -->
            <Frame BorderColor="LightGray" Padding="10" CornerRadius="8">
                <StackLayout Spacing="5">
                    <Label Text="Transaction Title" 
                           FontAttributes="Bold" 
                           FontFamily="Oswald" 
                           FontSize="16"/>
                    <Entry Text="{Binding Title}" 
                           FontSize="16" 
                           FontFamily="Oswald"
                           Placeholder="Enter transaction title"/>
                </StackLayout>
            </Frame>

            <!-- Transaction Amount -->
            <Frame BorderColor="LightGray" Padding="10" CornerRadius="8">
                <StackLayout Spacing="5">
                    <Label Text="Amount" 
                           FontAttributes="Bold" 
                           FontFamily="Oswald" 
                           FontSize="16"/>
                    <Entry Text="{Binding Amount}" 
                           Keyboard="Numeric" 
                           FontSize="16" 
                           FontFamily="Oswald"
                           Placeholder="Enter amount (£)"/>
                </StackLayout>
            </Frame>

            <!-- Transaction Category -->
            <Frame BorderColor="LightGray" Padding="10" CornerRadius="8">
                <StackLayout Spacing="5">
                    <Label Text="Category" 
                           FontAttributes="Bold" 
                           FontFamily="Oswald" 
                           FontSize="16"/>
                    <Picker ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}"
                            ItemDisplayBinding="{Binding Name}"
                            Title="Select a category"
                            FontFamily="Oswald"
                            FontSize="16"/>
                </StackLayout>
            </Frame>

            <!-- Transaction Date -->
            <Frame BorderColor="LightGray" Padding="10" CornerRadius="8">
                <StackLayout Spacing="5">
                    <Label Text="Date" 
                           FontAttributes="Bold" 
                           FontFamily="Oswald" 
                           FontSize="16"/>
                    <DatePicker Date="{Binding Date}" 
                                FontFamily="Oswald"
                                FontSize="16"/>
                </StackLayout>
            </Frame>

            <!-- Save & Delete Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Text="Save" 
                        Command="{Binding SaveCommand}" 
                        BackgroundColor="#EA4337"
                        TextColor="White"
                        FontFamily="Oswald"
                        FontSize="16"
                        Padding="0,10"
                        CornerRadius="8"/>
                
                <Button Grid.Column="1"
                        Text="Delete" 
                        Command="{Binding DeleteCommand}" 
                        BackgroundColor="#555555"
                        TextColor="White"
                        FontFamily="Oswald"
                        FontSize="16"
                        Padding="0,10"
                        CornerRadius="8"/>
            </Grid>

        </StackLayout>
    </ScrollView>
</ContentPage>